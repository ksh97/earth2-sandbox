# Android Emulator can reach the host machine through 10.0.2.2.
# iOS Simulator usually works with http://127.0.0.1:8000.
# Physical devices need your computer's LAN IP, such as http://192.168.0.10:8000.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Optional. Set this only when the backend runs with EARTH2_API_KEY_REQUIRED=true.
# The app sends it as X-API-Key but never displays the value in the debug screen.
EXPO_PUBLIC_API_KEY=
