# Copy this file to .env and fill in local values.
# Do not commit real API keys, passwords, or tokens.

EARTH2_APP_NAME=earth2-sandbox
EARTH2_ENVIRONMENT=local
EARTH2_LOG_LEVEL=INFO

EARTH2_DATA_DIR=./data
EARTH2_OUTPUT_DIR=./outputs
EARTH2_CHECKPOINT_DIR=./checkpoints

# Local/self-hosted FourCastNet NIM endpoint.
# Example after running a local NIM container: http://localhost:8000
EARTH2_FORECAST_PROVIDER=mock
EARTH2_FOURCASTNET_ENDPOINT_MODE=self_hosted
EARTH2_NIM_BASE_URL=http://localhost:8000
EARTH2_FOURCASTNET_HOSTED_URL=https://climate.api.nvidia.com/v1/nvidia/fourcastnet
EARTH2_NVCF_STATUS_URL=https://api.nvcf.nvidia.com/v2/nvcf/pexec/status

# Optional. Required for the hosted NVIDIA API mode.
EARTH2_NVIDIA_API_KEY=

# Deprecated compatibility flag. Use EARTH2_FORECAST_PROVIDER=mock instead.
EARTH2_ENABLE_MOCK_FORECAST=true
EARTH2_REQUEST_TIMEOUT_SECONDS=300
EARTH2_NVCF_MAX_POLL_ATTEMPTS=20
EARTH2_NVCF_POLL_INTERVAL_SECONDS=1
EARTH2_FOURCASTNET_CACHE_ENABLED=true
EARTH2_FOURCASTNET_CACHE_DIR=./data/cache/fourcastnet
EARTH2_FORECAST_QUEUE_BACKEND=memory
EARTH2_FORECAST_JOB_STORE_BACKEND=memory
EARTH2_FORECAST_JOB_STORE_DIR=./data/jobs
EARTH2_FORECAST_JOB_RETENTION_HOURS=168
EARTH2_FORECAST_JOB_STALE_TIMEOUT_SECONDS=1800

# Optional public API guard. Keep disabled for local prototype work.
EARTH2_API_KEY_REQUIRED=false
EARTH2_API_KEY=
EARTH2_API_KEYS=

# Optional in-memory rate limit for expensive forecast endpoints.
EARTH2_RATE_LIMIT_ENABLED=false
EARTH2_RATE_LIMIT_CAPACITY=60
EARTH2_RATE_LIMIT_WINDOW_SECONDS=60
EARTH2_RATE_LIMIT_ROUTES=GET /api/v1/forecast/point,GET /api/v1/forecast/sample,POST /api/v1/forecast/jobs,POST /api/v1/forecast/fourcastnet/hosted/infer
